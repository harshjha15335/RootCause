# Local mode needs no credentials. Never commit .env or credential values.
ROOTCAUSE_MODE=local-demo
# Azure mode requires real endpoints, an authenticated developer or managed identity,
# and access to the deployed model and services. Blank fields are not credentials.
COSMOS_ENDPOINT=
COSMOS_DATABASE=rootcause
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MAIN_MODEL=main
FOUNDRY_LIGHT_MODEL=light
EVENTHUB_NAMESPACE=
CONTENT_SAFETY_ENDPOINT=
TRANSLATOR_ENDPOINT=
SPEECH_ENDPOINT=
SPEECH_RESOURCE_ID=
AZURE_LOCATION=
AZURE_TENANT_ID=
API_CLIENT_ID=
DEBUGGER_MODULE=
FRONTEND_ORIGIN=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Non-secret Azure OpenAI-compatible endpoint for live Foundry groundedness evaluation.
EVALUATION_MODEL_ENDPOINT=
